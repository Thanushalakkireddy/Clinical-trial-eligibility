# =============================================================================
# Clinical Trial Eligibility - Backend environment template
# Copy this file to `.env` and fill in YOUR OWN values. Never commit `.env`.
# =============================================================================

# =============================================================================
# PRODUCTION DEPLOYMENT (Render backend + Vercel frontend)
# -----------------------------------------------------------------------------
# Backend (set in Render dashboard / render.yaml, NEVER in the frontend):
#   ENVIRONMENT=production
#   DEBUG=false
#   GEMINI_API_KEY=<server-side only - never expose to the browser>
#   GEMINI_MODEL=gemini-3.8-flash
#   DATABASE_URL=<Render PostgreSQL URL - postgresql://, postgresql+asyncpg://
#                  or postgres:// are all accepted>
#   CORS_ORIGINS=https://<your-app>.vercel.app   <- actual Vercel origin, no wildcard
#
# Frontend (set in Vercel dashboard, VITE_* vars are public, never secrets):
#   VITE_FASTAPI_BASE_URL=https://<your-render-api>.onrender.com
#   VITE_API_BASE_URL=https://<your-render-api>.onrender.com
# Never put GEMINI_API_KEY / DATABASE_URL / PostgreSQL credentials in VITE_ vars.
#
# Production migrations: `alembic upgrade head` (additive only; the running app
# never calls create_schema()/drop_schema()).
# Start command: uvicorn app.main:app --host 0.0.0.0 --port $PORT
# =============================================================================

# --- Application --------------------------------------------------------------
# Normal development / production requires the real external services below.
# Set ENVIRONMENT=test only for the automated test suite.
ENVIRONMENT=development
APP_NAME=clinical-trial-eligibility-api
PROJECT_NAME=Clinical Trial Eligibility API
API_V1_STR=/api/v1
DEBUG=true
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# =============================================================================
# Required in normal development / production:
# =============================================================================

# --- Gemini (required) ---------------------------------------------------------
# Your real Gemini API key. Leave empty here; provide it in your local .env.
# The API will not start without it during a normal run.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- PostgreSQL (required) -----------------------------------------------------
# Real PostgreSQL for SQLAlchemy async persistence + LangGraph checkpointing.
# Replace the placeholder USERNAME/PASSWORD/HOST/DATABASE with real values.
DATABASE_URL=postgresql+asyncpg://USERNAME:PASSWORD@HOST:5432/DATABASE

# =============================================================================
# Optional / storage / RAG / auth
# =============================================================================
PDF_STORAGE_DIR=./storage/pdfs
MAX_PDF_SIZE_MB=20
MAX_UPLOAD_SIZE_BYTES=20971520
FAISS_STORAGE_DIR=./data/vector_store
VECTOR_STORE_BACKEND=faiss
VECTOR_STORE_TYPE=faiss
VECTOR_STORE_PATH=./data/vector_store
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=8

# --- Auth (change these placeholders in your local .env) ------------------------
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Optional services (not required) -------------------------------------------
LLM_PROVIDER=gemini
REDIS_URL=